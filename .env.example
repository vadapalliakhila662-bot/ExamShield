# ExamShield Environment Configuration Template
# Copy this file to .env and populate your AWS / deployment parameters

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# OpenCV 5 Perception Configuration
OPENCV_REQUIRED_MAJOR_VERSION=5
CONFIDENCE_THRESHOLD_NORMAL=0.75
CONFIDENCE_THRESHOLD_DEGRADED=0.88
MIN_LUMINANCE_THRESHOLD=45.0
BLUR_LAPLACIAN_THRESHOLD=100.0

# Temporal Logic Parameters (Anti-Discrimination Rules)
TRANSIENT_WINDOW_SECONDS=120.0
SUSTAINED_WINDOW_SECONDS=600.0

# AWS Credentials & Configuration
# In production on EC2/ECS/Lambda, use IAM Instance Profiles instead of hardcoding keys
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS DynamoDB Tables
DYNAMODB_AUDIT_TABLE=ExamShield-Audit
DYNAMODB_SESSIONS_TABLE=ExamShield-Sessions

# AWS S3 Storage
S3_EVIDENCE_BUCKET=examshield-evidence-store
S3_LIFECYCLE_EXPIRATION_DAYS=30

# AWS Bedrock Foundation Model Access
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AWS Cognito Auth (Optional for Dashboard)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AWS COOL (Cloud-Optimized OpenCV Library - Graviton/ARM) Configuration
ENABLE_COOL_ACCELERATION=false
COOL_INSTANCE_TYPE=c7g.xlarge
